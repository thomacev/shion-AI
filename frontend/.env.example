# Development: leave empty to use Vite's same-origin /auth and /assistants proxy.
VITE_API_URL=
# Used only by the Vite development server; never sent to the browser.
DEV_API_TARGET=http://127.0.0.1:8000
# Production: serve the API at the same origin, or set VITE_API_URL to its origin
# and configure backend CORS/cookies for that deployment. No /api/v1 prefix.
